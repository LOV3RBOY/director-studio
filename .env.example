# Copy to .env.local. Nothing here is needed to run in mock mode.

# The media gateway key (treg.to). Without it the app runs in mock mode with sample files.
TREG_TOKEN=

# The MuAPI key for Seedance 2.5 (Five Star video). Falls back to DIRECTOR_MUAPI_KEY.
# MUAPI_API_KEY=
# Force a mode: mock | live. Default: live when TREG_TOKEN is set, otherwise mock.
# TREG_MODE=mock

# Stop sending paid requests once this many US dollars were spent in 24 hours.
TREG_DAILY_BUDGET_USD=5

# Where the database and generated files live. Default: ./data
# PARALLAX_DATA_DIR=

# Set to 1 to fill a new install with demo content: four house accounts and about sixty
# published pictures (all made with Parallax, each with the prompt that made it).
# It is added once per data directory. Nobody can sign in as the demo accounts.
# PARALLAX_DEMO_SEED=1

# Set to off to close the demo top-up button.
# PARALLAX_DEMO_BILLING=off

# On a private pilot server (STUDIO_PILOT_CODE set), the only address that may sign up and sign in
# with a password, and the testing credits it is topped up to at each sign-in.
# STUDIO_OWNER_EMAIL=
# The password the owner must sign up with (8+ characters). Keep it secret.
# STUDIO_OWNER_PASSWORD=
# STUDIO_OWNER_CREDITS=10000

# Set to 1 when serving over https, so the session cookie is marked Secure.
# COOKIE_SECURE=1

# Supercomputer (the agent chat). Without these it runs as a mock.
# SUPER_MODE=live
# ANTHROPIC_API_KEY=
# ORGO_API_KEY=
# COMPOSIO_API_KEY=

# Run the Supercomputer chat on a Hermes agent instead of the built-in loop.
# Read "Engines" in docs/api/super.md first. Keep the key and the token in files that only
# the server can read.
# SUPER_ENGINE=hermes
# HERMES_URL=http://127.0.0.1:8642
# HERMES_API_KEY_FILE=/path/to/hermes-api.key
# SUPER_ENGINE_TOKEN_FILE=/path/to/engine.token
# SUPER_ENGINE_NAME=Hermes
